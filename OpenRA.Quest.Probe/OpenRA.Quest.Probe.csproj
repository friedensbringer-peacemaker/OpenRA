<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.friedensbringer.openra.questprobe</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.2-preview</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <OpenRaToolchains Condition="'$(OpenRaToolchains)' == ''">$(MSBuildProjectDirectory)/../../.toolchains</OpenRaToolchains>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableQuestXr)' == 'true'">
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);QUEST_XR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenRA.Game/OpenRA.Game.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Common/OpenRA.Mods.Common.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Cnc/OpenRA.Mods.Cnc.csproj" />
    <ProjectReference Include="../OpenRA.Platforms.Default/OpenRA.Platforms.Default.csproj" />
    <AndroidAsset Include="../mods/common/**" Link="mods/common/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../mods/ra/**" Exclude="../mods/ra/maps/**" Link="mods/ra/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../mods/ra/maps/blitz.oramap" Link="mods/ra/maps/blitz.oramap" />
    <AndroidAsset Include="../glsl/**" Link="glsl/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../global mix database.dat" Link="global mix database.dat" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableQuestXr)' == 'true'">
    <AndroidManifestOverlay Include="QuestXrManifestOverlay.xml" />
    <AndroidJavaSource Include="../OpenRA.Quest.XrProbe/java/com/friedensbringer/openra/xr/XrProbe.java" Bind="true" />
    <AndroidNativeLibrary Include="$(OpenRaToolchains)/openra-xr-probe-build/libopenra_xr_probe.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(OpenRaToolchains)/openxr-loader-1.1.58/arm64-v8a/libopenxr_loader.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>
</Project>
